# The single configuration of the project, read by every service (crates/core/src/config.rs),
# the web build (web/vite.config.ts) and the scripts. Copy to .env (npm run setup does it).

# Application name and slug. APP_NAME is the single source of the app name (UI, API, page title);
# APP_SLUG is the machine-friendly name{% if features.auth %} (it names the session cookie){% endif %}.
APP_NAME="My App"
APP_SLUG=my-app

# SQLite database shared by the services, relative to the project root.
DB_PATH=data/my-app.sqlite

# 32 random bytes as hex (or base64): encrypts secrets at rest. `npm run setup` generates one.
# Changing it makes stored secrets unreadable. Never commit it.
MASTER_KEY=

# Ports. The edge is the public entry (API + built web app); every service has its own port.
EDGE_PORT=8700
{%- if features.auth %}
IDENTITY_PORT=8701
{%- endif %}
NOTES_PORT=8702
# Vite dev server (npm run dev); proxies /api to the edge.
WEB_PORT=5173

# Interface the services listen on; 0.0.0.0 accepts connections from other hosts.
BIND_HOST=127.0.0.1
# URL users open in the browser{% if features.auth %} (secure cookies when https){% endif %}. Default: the dev server, else the edge.
PUBLIC_URL=
# Built web app served by the edge.
WEB_DIST=web/dist

# error | warn | info | debug | trace, or a RUST_LOG filter like `info,app_notes=debug`.
LOG_LEVEL=info
{%- if choices.docker == "run" %}

# Docker Compose project name (names the container, image and volume).
COMPOSE_PROJECT_NAME=my-app
# Where the container keeps the database: `data` (a Docker volume) or `./data` (this folder).
DOCKER_DATA=data
{%- endif %}
