{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.web-app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts"]
}
